    "steps": [
      { "action": "doAction", "actionType": { "type": "attack" }, "expect": { "success": true, "dayActions": 2 } },
      { "action": "checkPlayer", "expect": { "dayActions": 2 } }
    ]
  },
  {
    "name": "4. Сбор ресурса:消耗 resource card",
    "userId": "test-svech-004",
