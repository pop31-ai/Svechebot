    "steps": [
      { "action": "doAction", "actionType": { "type": "collect" }, "expect": { "success": true, "dayActions": 1, "inventory": ["resource"] } },
      { "action": "checkPlayer", "expect": { "dayActions": 1, "inventory": ["resource"] } }
    ]
  },
  {
